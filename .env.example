# ── 查询服务（Node.js）─────────────────────────────────────────────
# OneBot v11 WebSocket 地址（SnowLuma 默认 3001）
SNOWLUMA_WS_URL=ws://127.0.0.1:3001/
# OneBot 鉴权 token（若上游/SnowLuma 未开启鉴权可留空）
SNOWLUMA_WS_TOKEN=

# 允许响应的 QQ 群号，逗号分隔。**留空 = 不响应任何群**（fail closed）
BOT_ALLOWED_GROUPS=

# 管理员 QQ 号（可用管理类指令），逗号分隔
BOT_ADMIN_IDS=

# 斗虫（VR_douchong）只读 API 基址
BILI_DOUCHONG_API=http://127.0.0.1:4666

# 订阅数据落盘目录
BOT_DATA_DIR=./data

# ── 通知层（Python，跑在上游进程内）────────────────────────────────
BILI_NOTIFY_ENABLED=1
BILI_NOTIFY_INITIAL_SILENT=1
BILI_NOTIFY_GROUPS=
ONEBOT_HTTP_URL=http://127.0.0.1:3000
